# Copy to your host's secret settings (never commit real values). Generate secrets: node scripts/gen-keys.js
NODE_ENV=production
BASE_URL=https://prompts360.si

# PostgreSQL (DigitalOcean managed). Use the direct connection for migrations; a PgBouncer pool URL is fine for the app
# if you also set DB_STARTUP_PARAMS=0 and run the ALTER ROLE lines from DEPLOY.md.
DATABASE_URL=postgresql://doadmin:…@…:25060/defaultdb?sslmode=verify-full
# CA certificate: the PEM text itself, or a path to the .crt file. TLS is always verified in production.
DATABASE_CA_CERT=
DATABASE_READ_URL=
DB_POOL_MAX=20
DB_STARTUP_PARAMS=1

# Valkey (DigitalOcean managed, TLS)
VALKEY_URL=rediss://default:…@…:25061

# Secrets: 32 random bytes, base64 each
APP_SECRET=
DATA_KEY=
DATA_KEY_OLD=

# Cloudflare Turnstile (free): https://dash.cloudflare.com → Turnstile → Add site
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Email: gmail (free, ~500/day on a personal account), resend, console. Comma-separate for fallback: gmail,resend
MAIL_TRANSPORT=gmail
MAIL_FROM=prompts360 <your.sender@gmail.com>
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
RESEND_API_KEY=

# Network / edge. App Platform: CLIENT_IP_HEADER=do-connecting-ip, EDGE_CACHE_SEC=0, no ORIGIN_SECRET.
# Droplets behind your own Cloudflare: CLIENT_IP_HEADER=cf-connecting-ip, EDGE_CACHE_SEC=30, ORIGIN_SECRET=<random>.
CLIENT_IP_HEADER=do-connecting-ip
EDGE_CACHE_SEC=0
ORIGIN_SECRET=

# Tuning
WEB_CONCURRENCY=1
ARGON_CONCURRENCY=4
